# 12자 이상의 운영 관리자 비밀번호로 변경하세요.
WEBOBSIDIAN_PASSWORD=replace-with-a-long-random-password

# 선택: Ollama Cloud 프록시의 업스트림 주소(기본값 https://ollama.com)
# WEBOBSIDIAN_OLLAMA_HOST=https://ollama.com

# 선택: Ollama Cloud 공유 설정(API 키, 모델) 저장 파일 경로
# 기본값은 vault 폴더 안의 .webobsidian-ollama.json 입니다.
# WEBOBSIDIAN_OLLAMA_SETTINGS_FILE=/data/vault/.webobsidian-ollama.json
